# Webex Integration (developer OAuth)
WEBEX_INTEGRATION_CLIENT_ID=
WEBEX_INTEGRATION_CLIENT_SECRET=
WEBEX_INTEGRATION_REDIRECT_URI=http://127.0.0.1:8765/callback

# Webex Service App
WEBEX_SA_CLIENT_ID=
WEBEX_SA_CLIENT_SECRET=

# Set on Render after running scripts/register_webhooks.py locally
WEBEX_INTEGRATION_REFRESH_TOKEN=

# Used by scripts/register_webhooks.py to register webhooks
# Also used to derive the BYODS data source URL on authorized webhooks
WEBEX_WEBHOOK_TARGET_URL=https://your-service.onrender.com/webhooks/webex

# Optional: public URL for data source registration when gRPC host differs from webhook host
# WEBEX_DATASOURCE_PUBLIC_URL=https://media.example.com:50051

# Auto-register a BYODS data source when a serviceApp authorized webhook is received
WEBEX_AUTO_REGISTER_DATASOURCE=true

# Data source registration (optional overrides; defaults shown)
WEBEX_DATASOURCE_PATH_SUFFIX=/grpc
WEBEX_DATASOURCE_SCHEMA_ID=5397013b-7920-4ffc-807c-e8a3e0a18f43
WEBEX_DATASOURCE_AUDIENCE=BYOVAGateway
WEBEX_DATASOURCE_SUBJECT=callAudioData
WEBEX_DATASOURCE_TOKEN_LIFE_MINUTES=1440

# Virtual agent catalog for Flow Designer (ListVirtualAgents)
WEBEX_VIRTUAL_AGENTS_CONFIG=config/virtual_agents.json

# BYOVA media server (webex-byova SDK BYOVAMediaServer)
WEBEX_MEDIA_ENABLED=true
WEBEX_MEDIA_HOST=0.0.0.0
WEBEX_MEDIA_PORT=50051
WEBEX_MEDIA_VERIFY_TOKENS=true
# WEBEX_MEDIA_ECHO_ENABLED=false

# Optional: rate limit webhook POSTs per client IP per minute
# RATE_LIMIT_PER_MINUTE=60

# HTTP server port (Render sets PORT automatically)
PORT=8000
